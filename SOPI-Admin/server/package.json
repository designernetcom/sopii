{
  "name": "sopii-admin-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "REST API for the SOPII admin panel — Express + MongoDB (Mongoose).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:fresh": "tsx src/db/seed.ts --fresh",
    "seed:banner-images": "tsx src/db/seed-banner-images.ts",
    "relink:images": "tsx src/db/relink-product-images.ts",
    "prune:blob-images": "tsx src/db/prune-blob-images.ts",
    "prune:dead-media": "tsx src/db/prune-dead-media.ts",
    "email:test": "tsx src/db/send-test-email.ts",
    "email:status": "tsx src/db/email-status.ts",
    "email:verify": "tsx src/db/email-verify.ts",
    "lint": "tsc --noEmit",
    "migrate:cloudinary": "tsx src/db/migrate-cloudinary.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "test:watch": "tsx --test --watch src/tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^8.0.1",
    "mongodb-memory-server": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
